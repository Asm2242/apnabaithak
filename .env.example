# Apna Baithak — environment variables
# Copy to .env and fill secrets. NEVER commit real secrets. NEVER put secrets in frontend code.

# Supabase (required)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Razorpay online payment (required for Online Payment; COD works without it)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OTP — pick one provider. If none is set, OTPs are logged server-side (dev only).
# MSG91 SMS OTP (preferred for SMS)
MSG91_API_KEY=
MSG91_SENDER=
MSG91_TEMPLATE_ID=
# WhatsApp Cloud API OTP (alternative)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=otp_verification
# Server-side pepper for OTP hashing (set a long random string in production)
OTP_PEPPER=
